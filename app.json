{
  "expo": {
    "name": "Spotter",
    "slug": "spotter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "spotter",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0088B0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.spotter.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Spotter uses the live camera to track pose, count reps, and flag form breaks. Nothing is uploaded.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0088B0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.spotter.app",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Spotter uses the live camera to track pose, count reps, and flag form breaks. Nothing is uploaded.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite"
    ]
  }
}
